# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/psych_support?sslmode=require"

# Authentication & Security (minimum 32-byte random secret for JWT HS256 & HMAC OTP hashing)
JWT_SECRET="replace-with-a-cryptographically-random-32-plus-char-secret"

# Optional Email OTP Salt/Pepper (defaults to JWT_SECRET if omitted)
OTP_SECRET=""

# AI Chat & IT Support Server Providers
CHAT_API_KEY="replace-with-apifree-api-key"
GEMINI_API_KEY="replace-with-google-gemini-api-key"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="replace-with-vercel-blob-read-write-token"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="\"PsychSupport Team\" <no-reply@example.com>"

# Application Origin (used for CSRF Origin verification in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
